def load_patients():
    conn = sqlite3.connect("databases/patient_data.db")
    cursor = conn.cursor()

    cursor.execute("SELECT dob " \
    ", child_name" \
    " FROM patients")

    rows = cursor.fetchall()

    for row in rows:
        patient_listbox.insert(tk.END, f"{row[0]} - {row[1]}")

    conn.close()

def on_select(event):

    conn = sqlite3.connect("databases/patient_data.db")
    cursor = conn.cursor()

    index = patient_listbox.curselection()
    text = patient_listbox.get(index)

    parts = text.split(" - ")
    child_name = parts[0]
    dob = parts[1]

    cursor.execute("SELECT * FROM patients WHERE child_name = ?  AND dob = ?",(child_name, dob))

    record = cursor.fetchone()

    conn.close()

    record_dict = dict(zip(columns, record))

    for col in columns:
        entries[col].delete(0, tk.END)
        entries[col].insert(0, record_dict[col])

