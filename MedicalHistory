import tkinter as tk
import sqlite3
import os
from tkinter import ttk, messagebox

root = tk.Tk()
root.title("Medical History")
root.geometry("500x750")

outer_container = tk.Frame(root)
outer_container.pack(fill="both", expand=True)

canvas = tk.Canvas(outer_container, highlightthickness=0, bd=0, bg=root.cget("bg"))
v_scrollbar = tk.Scrollbar(outer_container, orient="vertical", command=canvas.yview)
h_scrollbar = tk.Scrollbar(outer_container, orient="horizontal", command=canvas.xview)

main_frame = tk.Frame(canvas, padx=20, pady=20)
main_frame.pack(fill="both", expand=True)
main_frame.bind(
    "<Configure>",
    lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
)

canvas_window = canvas.create_window((0, 0), window=main_frame, anchor="nw")
canvas.configure(yscrollcommand=v_scrollbar.set, xscrollcommand=h_scrollbar.set)

v_scrollbar.pack(side="right", fill="y")
h_scrollbar.pack(side="bottom", fill="x")
canvas.pack(side="left", fill="both", expand=True)

def save_form():
    os.makedirs("databases", exist_ok=True)

    conn = sqlite3.connect("databases/patient_data.db")
    cursor = conn.cursor()

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS patients(
            medicalhistory_var TEXT,
            seen_neurologist INTEGER,
            neurologist_description TEXT,
            head_injury INTEGER,
            head_injury_description TEXT,
            head_injury_consciousness INTEGER,
            head_injury_confusion INTEGER,
            head_injury_hospitalization INTEGER,
            genetic_abnormalities INTEGER,
            genetic_abnormalities_description TEXT,
            seizure_epilepticattack INTEGER,
            baby_born_on_time INTEGER,
            baby_born_early_late TEXT,
            baby_born_on_time_weeks TEXT,
            gestational_age TEXT,
            birthweight TEXT,
            birthlength TEXT,
            complication_pregnancy INTEGER,
            complication_pregnancy_description TEXT,     
       )                     
    """)

    conn.commit()
    conn.close()

# -----------------------------
# Variables
# -----------------------------

medicalhistory_var = tk.StringVar()
seen_neurologist = tk.BooleanVar()
neurologist_description = tk.StringVar()
head_injury = tk.BooleanVar()
head_injury_description = tk.StringVar()
head_injury_consciousness = tk.BooleanVar()
head_injury_confusion = tk.BooleanVar()
head_injury_hospitalization = tk.BooleanVar()
genetic_abnormalitiies = tk.BooleanVar()
genetic_abnormalitiies_description = tk.StringVar()
seizure_epilepticattack = tk.BooleanVar()
baby_born_on_time = tk.BooleanVar()
baby_born_early_late = tk.StringVar()
baby_born_on_time_weeks = tk.StringVar()
gestational_age = tk.StringVar()
birthweight = tk.StringVar()
birthlength = tk.StringVar()
complication_pregnancy = tk.BooleanVar()
complication_pregnancy_description = tk.StringVar()

# -----------------------------
